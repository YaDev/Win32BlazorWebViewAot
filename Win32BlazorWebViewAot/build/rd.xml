<!--
  Native AOT runtime directives for Blazor Hybrid.

  Blazor's WebView IPC and JS interop still serialize with reflection-based System.Text.Json (the IL3050 warnings coming
  out of Microsoft.AspNetCore.Components.WebView and Microsoft.JSInterop). Under Native AOT, System.Text.Json builds the
  converters for collection types with MakeGenericType, and such an instantiation is only compiled when something roots
  it. Each entry below is one instantiation Blazor itself asks for at runtime; missing them fails as a MissingMethodException
  inside a message pump, far from the code that caused it.

  Remove this file once Blazor ships source-generated IPC serialization.
-->
<Directives xmlns="http://schemas.microsoft.com/netfx/2013/01/metadata">
  <Application>
    <Assembly Name="System.Text.Json">
      <!-- IpcCommon.TryDeserialize: an incoming IPC frame is a JsonElement[]. -->
      <Type Name="System.Text.Json.Serialization.Converters.ArrayConverter`2[[System.Text.Json.JsonElement[],System.Text.Json],[System.Text.Json.JsonElement,System.Text.Json]]" Dynamic="Required All" />

      <!-- IpcCommon.Serialize: an outgoing IPC payload is an IEnumerable<object>. -->
      <Type Name="System.Text.Json.Serialization.Converters.IEnumerableOfTConverter`2[[System.Collections.Generic.IEnumerable`1[[System.Object,System.Private.CoreLib]],System.Private.CoreLib],[System.Object,System.Private.CoreLib]]" Dynamic="Required All" />

      <!-- JSRuntime.InvokeAsync and the WebRenderer pass argument lists as object[]. -->
      <Type Name="System.Text.Json.Serialization.Converters.ArrayConverter`2[[System.Object[],System.Private.CoreLib],[System.Object,System.Private.CoreLib]]" Dynamic="Required All" />

      <!-- Enums that travel inside IPC and JS interop frames. -->
      <Type Name="System.Text.Json.Serialization.Converters.EnumConverter`1[[Microsoft.JSInterop.JSCallResultType,Microsoft.JSInterop]]" Dynamic="Required All" />
      <Type Name="System.Text.Json.Serialization.Converters.EnumConverter`1[[Microsoft.JSInterop.Infrastructure.JSCallType,Microsoft.JSInterop]]" Dynamic="Required All" />
      <Type Name="System.Text.Json.Serialization.Converters.EnumConverter`1[[Microsoft.AspNetCore.Components.WebRendererId,Microsoft.AspNetCore.Components.WebView]]" Dynamic="Required All" />
      <Type Name="System.Text.Json.Serialization.Converters.EnumConverter`1[[Microsoft.AspNetCore.Components.WebView.IpcCommon+IncomingMessageType,Microsoft.AspNetCore.Components.WebView]]" Dynamic="Required All" />
      <Type Name="System.Text.Json.Serialization.Converters.EnumConverter`1[[Microsoft.AspNetCore.Components.WebView.IpcCommon+OutgoingMessageType,Microsoft.AspNetCore.Components.WebView]]" Dynamic="Required All" />
    </Assembly>

    <Assembly Name="Microsoft.JSInterop">
      <!--
        JSRuntime.EndInvokeJS completes the awaiting TaskCompletionSource<T> through
        TaskGenericsUtil, which builds a TcsResultSetter<T> with MakeGenericType + Activator.CreateInstance. Nothing in
        IL ever names the closed instantiation, so the linker drops it and every JS call returning that type dies at
        completion with "missing native code or metadata" — far from the caller. These are the instantiations an app
        is most likely to await; an application awaiting some other value type roots its own:
        [DynamicDependency(DynamicallyAccessedMemberTypes.All, "Microsoft.JSInterop.Infrastructure.TaskGenericsUtil+TcsResultSetter`1[[My.Type,My.Assembly]]", "Microsoft.JSInterop")].
      -->
      <Type Name="Microsoft.JSInterop.Infrastructure.TaskGenericsUtil+TcsResultSetter`1[[System.Boolean,System.Private.CoreLib]]" Dynamic="Required All" />
      <Type Name="Microsoft.JSInterop.Infrastructure.TaskGenericsUtil+TcsResultSetter`1[[System.Byte,System.Private.CoreLib]]" Dynamic="Required All" />
      <Type Name="Microsoft.JSInterop.Infrastructure.TaskGenericsUtil+TcsResultSetter`1[[System.SByte,System.Private.CoreLib]]" Dynamic="Required All" />
      <Type Name="Microsoft.JSInterop.Infrastructure.TaskGenericsUtil+TcsResultSetter`1[[System.Int16,System.Private.CoreLib]]" Dynamic="Required All" />
      <Type Name="Microsoft.JSInterop.Infrastructure.TaskGenericsUtil+TcsResultSetter`1[[System.UInt16,System.Private.CoreLib]]" Dynamic="Required All" />
      <Type Name="Microsoft.JSInterop.Infrastructure.TaskGenericsUtil+TcsResultSetter`1[[System.Int32,System.Private.CoreLib]]" Dynamic="Required All" />
      <Type Name="Microsoft.JSInterop.Infrastructure.TaskGenericsUtil+TcsResultSetter`1[[System.UInt32,System.Private.CoreLib]]" Dynamic="Required All" />
      <Type Name="Microsoft.JSInterop.Infrastructure.TaskGenericsUtil+TcsResultSetter`1[[System.Int64,System.Private.CoreLib]]" Dynamic="Required All" />
      <Type Name="Microsoft.JSInterop.Infrastructure.TaskGenericsUtil+TcsResultSetter`1[[System.UInt64,System.Private.CoreLib]]" Dynamic="Required All" />
      <Type Name="Microsoft.JSInterop.Infrastructure.TaskGenericsUtil+TcsResultSetter`1[[System.Single,System.Private.CoreLib]]" Dynamic="Required All" />
      <Type Name="Microsoft.JSInterop.Infrastructure.TaskGenericsUtil+TcsResultSetter`1[[System.Double,System.Private.CoreLib]]" Dynamic="Required All" />
      <Type Name="Microsoft.JSInterop.Infrastructure.TaskGenericsUtil+TcsResultSetter`1[[System.Decimal,System.Private.CoreLib]]" Dynamic="Required All" />
      <Type Name="Microsoft.JSInterop.Infrastructure.TaskGenericsUtil+TcsResultSetter`1[[System.Char,System.Private.CoreLib]]" Dynamic="Required All" />
      <Type Name="Microsoft.JSInterop.Infrastructure.TaskGenericsUtil+TcsResultSetter`1[[System.DateTime,System.Private.CoreLib]]" Dynamic="Required All" />
      <Type Name="Microsoft.JSInterop.Infrastructure.TaskGenericsUtil+TcsResultSetter`1[[System.DateTimeOffset,System.Private.CoreLib]]" Dynamic="Required All" />
      <Type Name="Microsoft.JSInterop.Infrastructure.TaskGenericsUtil+TcsResultSetter`1[[System.Guid,System.Private.CoreLib]]" Dynamic="Required All" />
      <Type Name="Microsoft.JSInterop.Infrastructure.TaskGenericsUtil+TcsResultSetter`1[[System.String,System.Private.CoreLib]]" Dynamic="Required All" />
      <Type Name="Microsoft.JSInterop.Infrastructure.TaskGenericsUtil+TcsResultSetter`1[[System.Object,System.Private.CoreLib]]" Dynamic="Required All" />
    </Assembly>
  </Application>
</Directives>
