<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!--
    Razor components shared by the lifetime scenarios. They live apart from the runner so a host can drive
    the same component behaviour through any window type, and so the component assembly stays free of Win32 references.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>

    <!-- Test surface, not shipped API: Razor-generated code is not analyzer-clean and that is not actionable here. -->
    <NoWarn>$(NoWarn);BL2000;CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.15" />
  </ItemGroup>

</Project>
